<resources>
    <style
        name="Widget.Danhba.BottomNavigation"
        parent="Widget.Material3.BottomNavigationView">
        <item
            name="android:minHeight">64dp</item>
        <item
            name="android:background">@color/ui_background</item>
        <item
            name="elevation">0dp</item>
        <item
            name="labelVisibilityMode">labeled</item>
        <item
            name="itemIconSize">22dp</item>
        <item
            name="itemPaddingTop">6dp</item>
        <item
            name="itemPaddingBottom">6dp</item>
        <item
            name="itemIconTint">@color/navigation_item</item>
        <item
            name="itemTextColor">@color/navigation_item</item>
        <item
            name="itemRippleColor">@color/ui_container</item>
        <item
            name="itemActiveIndicatorStyle">@style/Widget.Danhba.NavigationIndicator</item>
    </style>
    <style
        name="Widget.Danhba.NavigationIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item
            name="android:color">@color/ui_container</item>
        <item
            name="android:height">28dp</item>
        <item
            name="android:width">56dp</item>
    </style>
</resources>
